    {
      "id": "HwRA61_gy_4zmnWCWqS4r",
      "type": "text",
      "x": 5034.061221637736,
      "y": -2194.238591698393,
      "width": 1102.1466064453125,
      "height": 594.0000000000005,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1f",
      "roundness": null,
      "seed": 1835579251,
      "version": 77,
      "versionNonce": 1594316979,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785445427878,
      "link": null,
      "locked": false,
      "text": "2. LoginView\nBottone Login:\nEvento: LoginWithEmailEvent(email, password)\nStato prima: AuthLoading\nUse case: LoginWithEmail\nSe va bene:\nStato: AuthAuthenticated(user)\nSe fallisce:\nStato: AuthError(message)\nSe Supabase risponde email_not_confirmed:Stato: AuthError(emailNotConfirmed: true)\nLa UI mostra popup “Email non verificata”.\n\nCatena:\nLoginView ->\n LoginWithEmailEvent -> \nAuthBloc -> LoginWithEmail -> \nAuthRepository.loginWithEmail ->\n AuthRemoteDataSource.loginWithEmail -> supabase.auth.signInWithPassword",
      "fontSize": 26.400000000000023,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. LoginView\nBottone Login:\nEvento: LoginWithEmailEvent(email, password)\nStato prima: AuthLoading\nUse case: LoginWithEmail\nSe va bene:\nStato: AuthAuthenticated(user)\nSe fallisce:\nStato: AuthError(message)\nSe Supabase risponde email_not_confirmed:Stato: AuthError(emailNotConfirmed: true)\nLa UI mostra popup “Email non verificata”.\n\nCatena:\nLoginView ->\n LoginWithEmailEvent -> \nAuthBloc -> LoginWithEmail -> \nAuthRepository.loginWithEmail ->\n AuthRemoteDataSource.loginWithEmail -> supabase.auth.signInWithPassword",
      "autoResize": true,
      "lineHeight": 1.25
    },
