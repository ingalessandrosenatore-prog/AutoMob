    {
      "id": "ZMvMsHSY2NjbY2ekmu2Uy",
      "type": "text",
      "x": -4371.921549053994,
      "y": 409.7190576607152,
      "width": 975.6876220703125,
      "height": 595,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Z",
      "roundness": null,
      "seed": 1383352943,
      "version": 118,
      "versionNonce": 1141097075,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785446448013,
      "link": null,
      "locked": false,
      "text": "Step 2: _CostsStep / “Costi”\nMostra totale:Derivato da state.partsTotal.\nNon emette eventi.\n\nRimuovi ricambio:Evento: RemovePartEvent.\nStato: rimuove il pezzo da selectedParts.\nUse case: nessuno.\n\nModifica quantità/prezzo/note ricambio:Evento: UpdatePartItemEvent.\nStato: aggiorna il SelectedPart.\nUse case: nessuno.\n\nPremi “Completa”:Evento: OnSubmitEvent.\nStato prima: WorkLogStatus.loading.\nUse case chiamato: CreateWorkLog.\nSe va bene: WorkLogStatus.success.\nSe fallisce: WorkLogStatus.failure.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 2: _CostsStep / “Costi”\nMostra totale:Derivato da state.partsTotal.\nNon emette eventi.\n\nRimuovi ricambio:Evento: RemovePartEvent.\nStato: rimuove il pezzo da selectedParts.\nUse case: nessuno.\n\nModifica quantità/prezzo/note ricambio:Evento: UpdatePartItemEvent.\nStato: aggiorna il SelectedPart.\nUse case: nessuno.\n\nPremi “Completa”:Evento: OnSubmitEvent.\nStato prima: WorkLogStatus.loading.\nUse case chiamato: CreateWorkLog.\nSe va bene: WorkLogStatus.success.\nSe fallisce: WorkLogStatus.failure.",
      "autoResize": true,
      "lineHeight": 1.25
    },
