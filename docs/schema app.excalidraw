      "boundElements": null,
      "updated": 1785445753997,
      "link": null,
      "locked": false,
      "text": "Nel datasource la signup passa\nanche:\nrole: proprietario/meccanico/admin\nfull_name: name\nredirect: com.infinty.automob://login-\ncallback/\nIn più, se serve verifica email:\nAuthRepository ->\nAuthLocalDataSource.savePendingEm\nailVerification ->\nSharedPreferencefffff",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "YliL9aGnTRTevpcaUcvQ7",
      "originalText": "Nel datasource la signup passa anche:\nrole: proprietario/meccanico/admin\nfull_name: name\nredirect: com.infinty.automob://login-callback/\nIn più, se serve verifica email:\nAuthRepository -> AuthLocalDataSource.savePendingEmailVerification -> SharedPreferencefffff",
      "autoResize": true,
      "lineHeight": 1.25
    },
