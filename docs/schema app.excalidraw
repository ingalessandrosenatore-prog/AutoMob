      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2y",
      "roundness": null,
      "seed": 329390579,
      "version": 43,
      "versionNonce": 1324231485,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785447203702,
      "link": null,
      "locked": false,
      "text": "Step 4: PhotoStepView\nEvento:\nPhotoStepSubmittedSalva la foto nel draft.\nPoi chiama il salvataggio finale.\nUse case:prima SaveDraftStep\npoi SaveVehicle\nse successo: ClearVehicleDraft\n\n\nStati:\nstatus: loading\nstatus: completed\nstatus: failure\nphotoWarning: true/false\nCatena finale:\nPhotoStepSubmitted\n -> VehicleRegistrationBloc\n -> SaveVehicle\n -> VehicleRepository.saveVehicle\n -> VehicleRemoteDataSource.saveVehicle\n -> Supabase RPC crea_veicolo_con_storico",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 4: PhotoStepView\nEvento:\nPhotoStepSubmittedSalva la foto nel draft.\nPoi chiama il salvataggio finale.\nUse case:prima SaveDraftStep\npoi SaveVehicle\nse successo: ClearVehicleDraft\n\n\nStati:\nstatus: loading\nstatus: completed\nstatus: failure\nphotoWarning: true/false\nCatena finale:\nPhotoStepSubmitted\n -> VehicleRegistrationBloc\n -> SaveVehicle\n -> VehicleRepository.saveVehicle\n -> VehicleRemoteDataSource.saveVehicle\n -> Supabase RPC crea_veicolo_con_storico",
      "autoResize": true,
      "lineHeight": 1.25
    },
