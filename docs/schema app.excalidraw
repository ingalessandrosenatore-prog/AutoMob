    {
      "id": "rEjvjSI4Fv2370FXCNIQI",
      "type": "text",
      "x": -3857.9610189884947,
      "y": -4063.9752857364447,
      "width": 1034.34765625,
      "height": 1225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
