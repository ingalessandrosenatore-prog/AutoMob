    {
      "id": "MW6EYxM7PGI4VtvwjrmdO",
      "type": "text",
      "x": 1732.7518344307045,
      "y": -3260.8578543937056,
      "width": 1065.644132527188,
      "height": 433.5238342285157,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
