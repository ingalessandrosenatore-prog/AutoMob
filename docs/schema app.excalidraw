    {
      "id": "EDLo75svZixptyqtBf35E",
      "type": "text",
      "x": -2779.7614468387483,
      "y": 2613.9256133134336,
      "width": 503.13177490234375,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2l",
      "roundness": null,
      "seed": 36562291,
      "version": 164,
      "versionNonce": 1439423091,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785447128211,
      "link": null,
      "locked": false,
      "text": "Step 0: MechanicStepView\nEventi:\nMechanicStepSubmitted\nSe inserisci codice meccanico.\nUse case: LookupMechanicByCode\nPoi salva bozza con SaveDraftStep.\n\nRegistrationWithoutMechanicPressed\nSe premi “Non ho un meccanico”.\nUse case: SaveDraftStep\nNon cerca nessun meccanico.\n\nStati toccati:\nmechanicStatus: loading\nmechanicStatus: found\nmechanicStatus: notFound\nmechanicStatus: failure\ncurrentStep = 1",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 0: MechanicStepView\nEventi:\nMechanicStepSubmitted\nSe inserisci codice meccanico.\nUse case: LookupMechanicByCode\nPoi salva bozza con SaveDraftStep.\n\nRegistrationWithoutMechanicPressed\nSe premi “Non ho un meccanico”.\nUse case: SaveDraftStep\nNon cerca nessun meccanico.\n\nStati toccati:\nmechanicStatus: loading\nmechanicStatus: found\nmechanicStatus: notFound\nmechanicStatus: failure\ncurrentStep = 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
