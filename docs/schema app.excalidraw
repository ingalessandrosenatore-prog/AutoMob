    {
      "id": "GYrAK3hWmdUoB0qysGutA",
      "type": "text",
      "x": -6734.408670209795,
      "y": -1333.6063005656965,
      "width": 1096.423583984375,
      "height": 840,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
